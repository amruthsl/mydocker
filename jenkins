pipeline {
    agent any

    stages {
        stage('Clone') {
            steps {
                git 'https://github.com/amruthsl/mydocker.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t mydocker:latest .'
            }
        }

        stage('Run Container') {
            steps {
                sh 'docker rm -f mydocker || true'
                sh 'docker run -d -p 8080:80 --name mydocker mydocker:latest'
            }
        }
    }
}
